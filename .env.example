# --- GitHub App credentials ---
# Register at https://github.com/settings/apps to get these
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/private-key.pem
GITHUB_WEBHOOK_SECRET=

# --- Google Gemini API ---
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Web dashboard auth ---
# Username/password to protect the dashboard (no registration flow)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin

# --- App settings ---
# Public base URL of your app, e.g. https://your-tunnel.ngrok.app
PUBLIC_BASE_URL=http://localhost:8000
# 0-100 threshold score below which a PR fails
PASS_THRESHOLD=70
# Max characters of diff text sent to Gemini per file chunk
MAX_DIFF_CHARS=60000
DATABASE_URL=sqlite:///./pr_review.db